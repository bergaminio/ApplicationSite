# Vorlage fuer die Datei .env
#
# So benutzt man sie:
#   cp .env.example .env
# Danach die Werte unten ausfuellen.
#
# DIESE Datei (.env.example) gehoert ins Repo, damit man sieht, welche
# Werte gebraucht werden. Die ausgefuellte .env NICHT - sie steht in
# .gitignore. Wer sie versehentlich hochlaedt, hat seine Passwoerter
# oeffentlich auf GitHub stehen.
#
# Passwoerter erzeugen (Linux/Mac, im Terminal):
#   openssl rand -base64 32
# Unter Windows in PowerShell:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Max 256 }))


# Passwort der Datenbank. Wird nur intern zwischen den Containern
# benutzt, niemand tippt es je ein - also ruhig lang und wirr.
DB_PASSWORD=

# Womit die Anmelde-Token unterschrieben werden.
# Mindestens 32 Zeichen. Wer dieses Geheimnis kennt, kann sich selbst
# gueltige Token bauen und kommt ohne Passwort an die Noten.
JWT_SECRET=

# Das Admin-Konto. Wird nur beim allerersten Start angelegt - danach
# aendert man das Passwort im Admin-Bereich der Website, und die
# Variable hier hat keine Wirkung mehr.
ADMIN_USERNAME=michael
ADMIN_PASSWORD=

# Unter welcher Adresse die Website spaeter laeuft.
# Ohne Schraegstrich am Ende. Steht hier die falsche Adresse, bricht
# jede Anfrage ans Backend mit "Failed to fetch" ab.
SITE_URL=https://bergamin.ch

# Unter welcher Adresse das Backend fuer den Browser erreichbar ist.
# Nicht "http://backend:8080" - diesen Namen kennt nur Docker intern,
# der Browser des Besuchers kommt da nicht hin.
API_URL=https://api.bergamin.ch

# Wohnort und Telefonnummer. Stehen nicht im Quelltext, weil das
# Repository oeffentlich ist. Der Server gibt sie nur an Angemeldete
# heraus. Leer lassen heisst: die Seite zeigt an der Stelle nichts.
CONTACT_PLACE=
CONTACT_PHONE=
